# OpenRouter API key (default cloud router)
OPENROUTER_API_KEY=

# Respan API key (used for workflow/tool tracing)
RESPAN_API_KEY=

# Optional default model ID (free OpenRouter slug, or ollama:/lmstudio:/anthropic:/gemini:/openai:)
POSEIDON_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional direct cloud provider keys (also configurable inside Settings -> Local AI & Keys)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional local AI OpenAI-compatible endpoints (auto-detects localhost vs host.docker.internal if unset)
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Optional web search API keys (when unset, web_search uses StackOverflow, GitHub, PyPI, Wikipedia)
TAVILY_API_KEY=
BRAVE_API_KEY=
